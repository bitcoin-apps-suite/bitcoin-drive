{
  "name": "bitcoin-drive",
  "version": "1.0.0",
  "description": "Decentralized file storage platform on BSV blockchain with NFT tokenization",
  "private": true,
  "scripts": {
    "dev": "next dev -p 2030",
    "build": "next build",
    "start": "next start -p 2030",
    "lint": "eslint",
    "test": "vitest run",
    "kill:3000": "lsof -ti:3000 | xargs kill -9",
    "kill:dev": "lsof -ti:3000 | xargs kill -9 && lsof -ti:3001 | xargs kill -9",
    "kill:all": "for port in {3000..3010}; do lsof -ti:$port | xargs kill -9 2>/dev/null || true; done"
  },
  "keywords": [
    "bitcoin",
    "bsv",
    "blockchain",
    "storage",
    "nft",
    "decentralized",
    "baps"
  ],
  "author": "The Bitcoin Corporation LTD",
  "license": "Open BSV License Version 5",
  "dependencies": {
    "@bsv/sdk": "^1.7.6",
    "autoprefixer": "^10.4.21",
    "bsv": "^2.0.10",
    "lucide-react": "^0.544.0",
    "next": "15.5.27",
    "postcss": "^8.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "tailwindcss": "^3.4.18"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "jsdom": "^30.1.1",
    "nodemon": "^3.1.10",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
